{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "allowJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "types": ["node", "@tarojs/taro"],
        "resolveJsonModule": true
    },
    "include": ["src", "config", "types", "tests/types"]
}
