{
    "name": "multi-database-demo-miniprogram",
    "version": "0.1.0",
    "private": true,
    "description": "多数据库 Demo 微信小程序开发模块",
    "scripts": {
        "dev:weapp": "pnpm codegen:check && taro build --type weapp --watch",
        "build:weapp": "pnpm typecheck && taro build --type weapp",
        "codegen": "node scripts/codegen.mjs",
        "codegen:check": "node scripts/codegen.mjs --check",
        "lint": "eslint src config types tests/types --max-warnings 0",
        "typecheck": "pnpm lint && pnpm codegen:check && tsc --noEmit",
        "check": "pnpm typecheck",
        "test": "node --test tests/node/*.test.cjs tests/node/*.test.mjs"
    },
    "dependencies": {
        "@apollo/client": "4.3.5",
        "@babel/runtime": "7.29.10",
        "@tarojs/components": "4.3.0",
        "@tarojs/helper": "4.3.0",
        "@tarojs/plugin-framework-react": "4.3.0",
        "@tarojs/plugin-platform-weapp": "4.3.0",
        "@tarojs/react": "4.3.0",
        "@tarojs/runtime": "4.3.0",
        "@tarojs/shared": "4.3.0",
        "@tarojs/taro": "4.3.0",
        "dayjs": "1.11.23",
        "graphql": "17.0.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "rxjs": "7.8.2",
        "tdesign-miniprogram": "1.17.0",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/plugin-proposal-decorators": "7.29.7",
        "@babel/preset-react": "7.29.7",
        "@graphql-codegen/cli": "7.4.6",
        "@graphql-codegen/typescript-operations": "6.1.10",
        "@tarojs/cli": "4.3.0",
        "@tarojs/vite-runner": "4.3.0",
        "@types/node": "22.20.5",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "babel-preset-taro": "4.3.0",
        "eslint": "10.13.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.0",
        "vite": "7.3.7",
        "weapp-tailwindcss": "5.6.3"
    }
}
