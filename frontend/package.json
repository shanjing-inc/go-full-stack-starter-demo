{
    "name": "multi-database-demo-dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "pnpm codegen:check && tsc6 --noEmit && vite build",
        "typecheck": "pnpm codegen:check && tsc6 --noEmit",
        "test": "node --test vite.config.test.mjs scripts/*.test.mjs",
        "test:browser": "playwright test",
        "codegen": "node scripts/codegen.mjs",
        "codegen:check": "node scripts/codegen.mjs --check"
    },
    "dependencies": {
        "@shanjing/shadcnui-dashboard": "0.1.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "8.3.0",
        "lucide-react": "1.25.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "5.2.0",
        "vite": "8.1.5",
        "@playwright/test": "1.61.1",
        "@tailwindcss/vite": "4.2.2",
        "tailwindcss": "4.2.2",
        "tw-animate-css": "1.4.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "@graphql-codegen/cli": "7.2.0",
        "@graphql-codegen/typescript-operations": "6.1.1",
        "graphql": "17.0.2",
        "prettier": "3.6.2"
    }
}
