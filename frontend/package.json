{
    "name": "multi-database-demo-dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "pnpm codegen:check && tsc6 --noEmit && vite build",
        "typecheck": "pnpm lint && pnpm codegen:check && tsc6 --noEmit",
        "test": "pnpm test:node && pnpm test:unit",
        "test:browser": "playwright test",
        "codegen": "node scripts/codegen.mjs",
        "codegen:check": "node scripts/codegen.mjs --check",
        "lint": "eslint src tests/unit tests/types tests/setup.ts --max-warnings 0",
        "test:node": "node --test tests/node/*.test.mjs",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@apollo/client": "4.3.3",
        "@shanjing/shadcnui-dashboard": "0.1.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "8.3.0",
        "lucide-react": "1.25.0",
        "zod": "4.6.5",
        "@sentry/react": "11.6.0",
        "graphql": "17.0.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "5.2.0",
        "vite": "8.1.5",
        "@playwright/test": "1.61.1",
        "@tailwindcss/vite": "4.2.2",
        "tailwindcss": "4.2.2",
        "tw-animate-css": "1.4.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "@graphql-codegen/cli": "7.2.0",
        "@graphql-codegen/typescript-operations": "6.1.1",
        "prettier": "3.6.2",
        "eslint": "9.39.5",
        "typescript-eslint": "8.71.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/user-event": "14.6.7",
        "@testing-library/dom": "10.4.1",
        "jsdom": "30.1.2",
        "vitest": "4.1.10"
    }
}
