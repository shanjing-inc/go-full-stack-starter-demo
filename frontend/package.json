{
    "name": "multi-database-demo-dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "pnpm codegen:check && node node_modules/typescript7/bin/tsc --noEmit && vite build",
        "typecheck": "pnpm lint && pnpm codegen:check && node node_modules/typescript7/bin/tsc --noEmit",
        "test": "pnpm test:node && pnpm test:unit",
        "test:browser": "playwright test",
        "codegen": "node scripts/codegen.mjs",
        "codegen:check": "node scripts/codegen.mjs --check",
        "lint": "eslint src tests/unit tests/types tests/setup.ts --max-warnings 0",
        "test:node": "node --test tests/node/*.test.mjs",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@apollo/client": "4.3.4",
        "@shanjing/shadcnui-dashboard": "1.2.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.4.0",
        "lucide-react": "1.58.0",
        "zod": "4.6.7",
        "@sentry/react": "11.8.0",
        "graphql": "17.0.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "6.1.2",
        "vite": "8.3.4",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "4.3.3",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript7": "npm:typescript@7.0.2",
        "@graphql-codegen/cli": "7.4.6",
        "@graphql-codegen/typescript-operations": "6.1.10",
        "prettier": "3.9.10",
        "eslint": "10.13.0",
        "typescript-eslint": "8.71.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/user-event": "14.6.8",
        "@testing-library/dom": "10.4.2",
        "jsdom": "30.1.3",
        "vitest": "5.0.5"
    }
}
