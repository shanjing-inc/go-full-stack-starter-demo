# 从参考项目 SDL 提取；ShopItem 当前覆盖标量字段。
scalar DateTime

input IntFilters {
    eq: Int
    gt: Int
    gte: Int
    inArray: [Int!]
    isNotNull: Boolean
    isNull: Boolean
    lt: Int
    lte: Int
    ne: Int
    notInArray: [Int!]
}

input StringFilters {
    eq: String
    gt: String
    gte: String
    ilike: String
    inArray: [String!]
    isNotNull: Boolean
    isNull: Boolean
    like: String
    lt: String
    lte: String
    ne: String
    notIlike: String
    notInArray: [String!]
    notLike: String
}

input ShopFilters {
    id: IntFilters
    slug: StringFilters
    status: StringFilters
}

type ShopItem {
    createdAt: DateTime
    id: ID
    name: String
    slug: String
    status: String
    updatedAt: DateTime
}
