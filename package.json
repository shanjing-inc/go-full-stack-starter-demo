{
    "name": "multi-database-demo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.15.1",
    "scripts": {
        "setup": "python3 scripts/setup.py",
        "generate": "python3 scripts/project.py generate",
        "schema": "python3 scripts/project.py schema",
        "schema:diff": "python3 scripts/project.py diff",
        "migrate": "python3 scripts/project.py migrate",
        "check": "python3 scripts/project.py check && pnpm check:weapp",
        "test": "python3 scripts/project.py test && pnpm test:weapp",
        "test:go": "python3 scripts/project.py test-go",
        "test:go:coverage": "python3 scripts/project.py test-go --coverage",
        "build": "python3 scripts/project.py build",
        "build:frontend": "pnpm --filter multi-database-demo-dashboard build",
        "test:browser": "pnpm --filter multi-database-demo-dashboard test:browser",
        "format": "python3 scripts/format.py",
        "format:check": "python3 scripts/format.py --check",
        "clean:runtime": "python3 scripts/clean-runtime.py",
        "clean:cache": "python3 scripts/clean-runtime.py --cache-only",
        "clean:all": "python3 scripts/clean-runtime.py --cache",
        "codegen": "pnpm --filter multi-database-demo-dashboard codegen && pnpm --filter multi-database-demo-miniprogram codegen",
        "codegen:check": "pnpm --filter multi-database-demo-dashboard codegen:check && pnpm --filter multi-database-demo-miniprogram codegen:check",
        "lint": "pnpm --filter multi-database-demo-dashboard lint && pnpm --filter multi-database-demo-miniprogram lint",
        "dev": "python3 scripts/dev.py",
        "dev:weapp": "pnpm --filter multi-database-demo-miniprogram dev:weapp",
        "build:weapp": "pnpm --filter multi-database-demo-miniprogram build:weapp",
        "check:weapp": "pnpm --filter multi-database-demo-miniprogram check",
        "test:weapp": "pnpm --filter multi-database-demo-miniprogram test"
    },
    "devDependencies": {
        "prettier": "3.9.10"
    }
}
