{
    "name": "multi-database-demo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.15.1",
    "scripts": {
        "setup": "node scripts/go-starter.mjs setup",
        "generate": "node scripts/go-starter.mjs generate",
        "schema": "node scripts/go-starter.mjs schema",
        "schema:diff": "node scripts/go-starter.mjs diff",
        "migrate": "node scripts/go-starter.mjs migrate",
        "check": "node scripts/go-starter.mjs check && pnpm check:weapp",
        "test": "node scripts/go-starter.mjs test && pnpm test:weapp",
        "test:go": "node scripts/go-starter.mjs test-go",
        "test:go:coverage": "node scripts/go-starter.mjs test-go --coverage",
        "build": "node scripts/go-starter.mjs build",
        "build:frontend": "pnpm --filter multi-database-demo-dashboard build",
        "test:browser": "pnpm --filter multi-database-demo-dashboard test:browser",
        "format": "node scripts/go-starter.mjs format",
        "format:check": "node scripts/go-starter.mjs format --check",
        "clean:runtime": "node scripts/go-starter.mjs clean",
        "clean:cache": "node scripts/go-starter.mjs clean --cache-only",
        "clean:all": "node scripts/go-starter.mjs clean --cache",
        "codegen": "pnpm --filter multi-database-demo-dashboard codegen && pnpm --filter multi-database-demo-miniprogram codegen",
        "codegen:check": "pnpm --filter multi-database-demo-dashboard codegen:check && pnpm --filter multi-database-demo-miniprogram codegen:check",
        "lint": "pnpm --filter multi-database-demo-dashboard lint && pnpm --filter multi-database-demo-miniprogram lint",
        "tools:info": "node scripts/go-starter.mjs --info",
        "dev": "node scripts/go-starter.mjs dev",
        "dev:weapp": "pnpm --filter multi-database-demo-miniprogram dev:weapp",
        "build:weapp": "pnpm --filter multi-database-demo-miniprogram build:weapp",
        "check:weapp": "pnpm --filter multi-database-demo-miniprogram check",
        "test:weapp": "pnpm --filter multi-database-demo-miniprogram test"
    },
    "devDependencies": {
        "@shanjing/go-starter-devtools": "0.1.3",
        "prettier": "3.6.2"
    }
}
