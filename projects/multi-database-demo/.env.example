# 邮箱密码认证；生产部署使用 HTTPS，Cookie 自动开启 Secure。
APP_MODE=development
REDIS_URL=redis://127.0.0.1:6379/0
# 沿用既有 Redis namespace；数据库名与 namespace 按部署配置保持稳定。
APP_NAMESPACE=go-mysql-demo
# 方言由 DB_DSN 协议推导；替换示例密码；用户名、密码中的非 ASCII 字符及 @、:、/、?、#、% 需要 URL 百分号编码。
DB_DSN=mysql://dev:replace-password@127.0.0.1:3306/go_mysql_demo?parseTime=true&loc=UTC&timeout=1s&readTimeout=2s&writeTimeout=2s
# PostgreSQL 替代示例：同步替换 DB_DSN 与 MIGRATION_URL。
# DB_DSN=postgres://dev:replace-password@127.0.0.1:5432/go_mysql_demo?sslmode=disable&timezone=UTC&connect_timeout=2&search_path=public
# SQLite 快速测试示例：DB_DSN=sqlite:///tmp/go_mysql_demo.sqlite
DB_VERSION=202610040001
# Atlas 使用独立迁移账户。URL 在本地环境文件配置，避免写入 Git。
MIGRATION_URL=mysql://migration:replace-password@127.0.0.1:3306/go_mysql_demo
# MIGRATION_URL=postgres://migration:replace-password@127.0.0.1:5432/go_mysql_demo?sslmode=disable&search_path=public
# schema diff 使用可清空的独立开发库；PostgreSQL diff 会移除 search_path 并按数据库级清理全部 schema。
# ATLAS_DEV_URL=postgres://migration:replace-password@127.0.0.1:5432/go_mysql_demo_dev?sslmode=disable
# 本地 PostgreSQL 可使用 sslmode=disable；生产使用 sslmode=verify-full 并配置 CA。
WEB_ADDR=127.0.0.1:8080
SPA_PORT=5173
ALLOW_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
WORKER_CONCURRENCY=2
# 执行历史和手动重试审计保留 1–365 天；未结束任务链持续保留。
QUEUE_RECORD_RETENTION_DAYS=7
SHUTDOWN_TIMEOUT=4s

# 使用密码管理器生成至少 32 字节随机值，跨 Web 实例保持一致。
AUTH_SECRET=
# 首位 owner 初始化时临时设置；完成后清空并重启 Web。
AUTH_BOOTSTRAP_TOKEN=
